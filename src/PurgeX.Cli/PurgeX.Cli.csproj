<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Консольная оболочка. Нужна на этапе, когда ядро уже работает, а интерфейса ещё нет:
    позволяет проверить весь сценарий целиком на реальной машине.
    В дальнейшем станет основой тихого режима запуска по расписанию.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>PurgeX.Cli</RootNamespace>
    <AssemblyName>purgex</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PurgeX.Abstractions\PurgeX.Abstractions.csproj" />
    <ProjectReference Include="..\PurgeX.Core\PurgeX.Core.csproj" />
    <ProjectReference Include="..\PurgeX.Platform.Windows\PurgeX.Platform.Windows.csproj" />
  </ItemGroup>

</Project>
