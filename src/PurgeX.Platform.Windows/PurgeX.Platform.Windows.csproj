<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Платформенный слой: единственное место, где продукт обращается к файловой системе,
    реестру и системным вызовам Windows. Всё остальное работает через контракты.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>PurgeX.Platform.Windows</RootNamespace>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PurgeX.Abstractions\PurgeX.Abstractions.csproj" />
    <ProjectReference Include="..\PurgeX.Core\PurgeX.Core.csproj" />
  </ItemGroup>

</Project>
