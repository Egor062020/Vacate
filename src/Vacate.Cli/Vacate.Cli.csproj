<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Консольная оболочка. Нужна на этапе, когда ядро уже работает, а интерфейса ещё нет:
    позволяет проверить весь сценарий целиком на реальной машине.
    В дальнейшем станет основой тихого режима запуска по расписанию.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Vacate.Cli</RootNamespace>
    <!--
      Имя отличается от графического приложения намеренно. Windows не различает
      регистр в именах файлов, и «Vacate.exe» с «vacate.exe» в одной папке
      затирают друг друга при публикации — обнаружено при сборке поставки.
    -->
    <AssemblyName>vacate-cli</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vacate.Abstractions\Vacate.Abstractions.csproj" />
    <ProjectReference Include="..\Vacate.Core\Vacate.Core.csproj" />
    <ProjectReference Include="..\Vacate.Platform.Windows\Vacate.Platform.Windows.csproj" />
  </ItemGroup>

</Project>
