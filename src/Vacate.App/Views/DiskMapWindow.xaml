<Window x:Class="Vacate.App.Views.DiskMapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Карта диска"
        Height="720" Width="1000"
        MinHeight="520" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource PageTitle}" Text="Карта диска" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Площадь прямоугольника — занятое место. Щелчок открывает папку, двойной щелчок по «файлам в этой папке» показывает её в проводнике." />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
            <Button x:Name="UpButton" Style="{StaticResource SecondaryButton}" Content="Наверх"
                    Click="OnUp" IsEnabled="False" />
            <TextBlock x:Name="PathText" Style="{StaticResource MonoText}" VerticalAlignment="Center"
                       Margin="14,0,0,0" />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4">
            <Grid>
                <Canvas x:Name="MapCanvas" ClipToBounds="True" Background="Transparent"
                        SizeChanged="OnCanvasResized" />

                <TextBlock x:Name="BusyText" Style="{StaticResource BodyText}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed" Text="Считаю размеры…" />
            </Grid>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="3" Style="{StaticResource SecondaryText}" Margin="0,12,0,0" />
    </Grid>
</Window>
