<Window x:Class="Vacate.App.Views.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Удаление программы"
        Height="720" Width="780"
        MinHeight="520" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}"
        ResizeMode="CanResize">

    <!--
        Одно окно на весь ход удаления, а не череда всплывающих сообщений.
        Человек должен видеть, на каком он шаге и что уже сделано: цепочка окон,
        каждое из которых закрывается и сменяется следующим, оставляет его
        без картины происходящего ровно там, где решается судьба его файлов.
    -->
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="StepTitle" Style="{StaticResource PageTitle}" />
            <TextBlock x:Name="StepSubtitle" Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <!-- Шаг 1: что именно удаляем и чем это грозит -->
        <ScrollViewer x:Name="ConfirmPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="AppName" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                        <TextBlock x:Name="AppDetails" Style="{StaticResource MonoText}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Предупреждение показывается только когда есть о чём предупреждать -->
                <Border x:Name="WarningCard" Style="{StaticResource Card}" Margin="0,14,0,0"
                        BorderBrush="{StaticResource WarningBrush}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Стоит знать до нажатия" Style="{StaticResource SectionTitle}"
                                   Margin="0,0,0,8" Foreground="{StaticResource WarningBrush}" />
                        <TextBlock x:Name="WarningText" Style="{StaticResource BodyText}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Как это будет" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,6"
                                   Text="1. Запустится деинсталлятор самой программы. Он чужой: что он спросит и что удалит, решает он, а не Vacate." />
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,6"
                                   Text="2. Затем Vacate поищет то, что деинсталлятор оставил после себя." />
                        <TextBlock Style="{StaticResource BodyText}"
                                   Text="3. Найденное покажет списком — удалять или нет, решите вы. Ничего не исчезнет без вашей отметки." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Шаг 2: деинсталлятор работает -->
        <StackPanel x:Name="BusyPanel" Grid.Row="1" Visibility="Collapsed" VerticalAlignment="Center">
            <TextBlock x:Name="BusyText" Style="{StaticResource BodyText}" HorizontalAlignment="Center"
                       Margin="0,0,0,18" />
            <ProgressBar IsIndeterminate="True" Height="3" Width="320" Foreground="{StaticResource AccentBrush}"
                         Background="{StaticResource BorderBrush}" BorderThickness="0" />
        </StackPanel>

        <!-- Шаг 3: что осталось после деинсталлятора -->
        <Grid x:Name="LeftoverPanel" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="0">
                <ListBox x:Name="LeftoverItems" Padding="14" Background="Transparent" BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="Transparent" Padding="0,5">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                          VerticalAlignment="Top" Margin="0,2,12,0" />

                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource BodyText}" Text="{Binding Kind}" />
                                        <Border Background="{Binding ConfidenceBrush}" CornerRadius="4"
                                                Padding="7,2" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding ConfidenceLabel}" FontSize="10"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource MonoText}" Text="{Binding Path}" Margin="0,3,0,0" />
                                    <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding Evidence}" Margin="0,3,0,0" />
                                </StackPanel>

                                <TextBlock Grid.Column="2" Style="{StaticResource BodyText}" Text="{Binding Size}"
                                           FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" Margin="14,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <TextBlock x:Name="LeftoverHint" Grid.Row="1" Style="{StaticResource SecondaryText}" Margin="0,12,0,0" />
        </Grid>

        <!-- Шаг 4: чем всё кончилось -->
        <ScrollViewer x:Name="ResultPanel" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource Card}">
                <TextBlock x:Name="ResultText" Style="{StaticResource BodyText}" />
            </Border>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}" Content="Отмена"
                    Margin="0,0,10,0" Click="OnCancel" />
            <Button x:Name="ActionButton" Style="{StaticResource PrimaryButton}" Content="Удалить программу"
                    Click="OnAction" />
        </StackPanel>
    </Grid>
</Window>
