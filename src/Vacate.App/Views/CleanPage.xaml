<UserControl x:Class="Vacate.App.Views.CleanPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Vacate.App.Localization">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource PageTitle}" Text="{loc:Loc Clean.Title}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="{loc:Loc Clean.Subtitle}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <Button x:Name="ScanButton" Style="{StaticResource PrimaryButton}" Content="{loc:Loc Clean.Scan}" Click="OnScan" />
            <Button x:Name="PreviewButton" Style="{StaticResource SecondaryButton}" Content="{loc:Loc Clean.Preview}"
                    Click="OnPreview" Margin="10,0,0,0" IsEnabled="False" />
            <Button x:Name="CleanButton" Style="{StaticResource SecondaryButton}" Content="{loc:Loc Clean.Run}"
                    Click="OnClean" Margin="10,0,0,0" IsEnabled="False" />
            <!--
                Полоса хода работы. Появляется только во время сканирования: постоянно
                висящая полоса перестаёт что-либо значить, а во время работы человек
                должен видеть, что программа занята, а не зависла.
            -->
            <Border x:Name="ScanIndicator" Width="120" Height="3" Margin="16,0,0,0"
                    VerticalAlignment="Center" CornerRadius="2" Visibility="Collapsed"
                    Background="{StaticResource BorderBrush}" ClipToBounds="True">
                <Border x:Name="ScanPulse" Width="40" HorizontalAlignment="Left" CornerRadius="2"
                        Background="{StaticResource AccentBrush}">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="ScanPulseShift" />
                    </Border.RenderTransform>
                </Border>
            </Border>

            <TextBlock x:Name="StatusText" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="16,0,0,0" />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18">
                <ItemsControl x:Name="GroupsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Отметка решает, попадёт ли категория в очистку.
                                     Отмечено то, что безопасно; остальное человек включает сам. -->
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                          VerticalAlignment="Top" Margin="0,2,12,0" />

                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding Title}" />
                                    <TextBlock Style="{StaticResource MonoText}" Text="{Binding Path}" Margin="0,2,0,0" />
                                    <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding Consequence}"
                                               Margin="0,3,0,0" Visibility="{Binding ConsequenceVisibility}" />
                                </StackPanel>

                                <TextBlock Grid.Column="2" Style="{StaticResource BodyText}" Text="{Binding SizeText}"
                                           FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,14,0,0" Visibility="Collapsed" x:Name="ResultCard">
            <StackPanel>
                <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{loc:Loc Clean.Result}" />
                <TextBlock x:Name="ResultClaimed" Style="{StaticResource SecondaryText}" Margin="0,8,0,0" />
                <TextBlock x:Name="ResultActual" Style="{StaticResource BodyText}" Margin="0,4,0,0" />
                <ItemsControl x:Name="DiscrepancyList" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding}" Margin="0,2,0,0" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
