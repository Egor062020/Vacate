<UserControl x:Class="Vacate.App.Views.CleanPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource PageTitle}" Text="Очистка мусора" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Временные файлы и кэши. Файлы моложе суток не трогаются: их может использовать работающая программа." />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <Button x:Name="ScanButton" Style="{StaticResource PrimaryButton}" Content="Сканировать" Click="OnScan" />
            <Button x:Name="PreviewButton" Style="{StaticResource SecondaryButton}" Content="Показать, что будет сделано"
                    Click="OnPreview" Margin="10,0,0,0" IsEnabled="False" />
            <Button x:Name="CleanButton" Style="{StaticResource SecondaryButton}" Content="Очистить"
                    Click="OnClean" Margin="10,0,0,0" IsEnabled="False" />
            <TextBlock x:Name="StatusText" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="16,0,0,0" />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18">
                <ItemsControl x:Name="GroupsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding Title}" />
                                    <TextBlock Style="{StaticResource MonoText}" Text="{Binding Path}" Margin="0,2,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Style="{StaticResource BodyText}" Text="{Binding SizeText}"
                                           FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,14,0,0" Visibility="Collapsed" x:Name="ResultCard">
            <StackPanel>
                <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="Результат" />
                <TextBlock x:Name="ResultClaimed" Style="{StaticResource SecondaryText}" Margin="0,8,0,0" />
                <TextBlock x:Name="ResultActual" Style="{StaticResource BodyText}" Margin="0,4,0,0" />
                <ItemsControl x:Name="DiscrepancyList" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding}" Margin="0,2,0,0" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
