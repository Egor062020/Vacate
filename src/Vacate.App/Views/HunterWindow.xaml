<Window x:Class="Vacate.App.Views.HunterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Что это за программа"
        Height="440" Width="560"
        MinHeight="380" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}"
        ResizeMode="CanResize"
        Topmost="True">

    <!--
        Окно держится поверх остальных: смысл всего действия в том, чтобы человек
        видел одновременно и прицел, и то окно, на которое он его наводит.
    -->
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource PageTitle}" Text="Что это за программа" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Нажмите на прицел, не отпуская кнопку, доведите его до нужного окна и отпустите. Vacate определит, чем это окно запущено." />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Прицел. Рисуется линиями, а не берётся из шрифта: значок из шрифта
                 зависел бы от того, что установлено на машине человека. -->
            <Border Grid.Row="0" x:Name="Crosshair" Style="{StaticResource Card}"
                    HorizontalAlignment="Left" Padding="18" Cursor="Cross"
                    MouseLeftButtonDown="OnHuntStart">
                <Canvas Width="44" Height="44">
                    <Ellipse Canvas.Left="4" Canvas.Top="4" Width="36" Height="36"
                             Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="2" />
                    <Ellipse Canvas.Left="17" Canvas.Top="17" Width="10" Height="10"
                             Fill="{StaticResource AccentBrush}" />
                    <Line X1="22" Y1="0" X2="22" Y2="10" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="2" />
                    <Line X1="22" Y1="34" X2="22" Y2="44" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="2" />
                    <Line X1="0" Y1="22" X2="10" Y2="22" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="2" />
                    <Line X1="34" Y1="22" X2="44" Y2="22" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="2" />
                </Canvas>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock x:Name="ResultTitle" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"
                               Text="Наведите прицел на окно" />
                    <TextBlock x:Name="ResultDetails" Style="{StaticResource MonoText}" TextWrapping="Wrap" />
                    <TextBlock x:Name="ResultNote" Style="{StaticResource SecondaryText}" Margin="0,10,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CloseButton" Style="{StaticResource SecondaryButton}" Content="Закрыть"
                    Margin="0,0,10,0" Click="OnClose" />
            <Button x:Name="UninstallButton" Style="{StaticResource PrimaryButton}" Content="Удалить эту программу"
                    IsEnabled="False" Click="OnUninstall" />
        </StackPanel>
    </Grid>
</Window>
