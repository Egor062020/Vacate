<UserControl x:Class="Vacate.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Vacate.App.Localization">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource PageTitle}" Text="{loc:Loc Settings.Title}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="{loc:Loc Settings.Subtitle}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Автоматическая очистка -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Margin="0,0,0,4" Text="{loc:Loc Settings.Schedule}" />
                        <TextBlock Style="{StaticResource SecondaryText}" Margin="0,0,0,14"
                                   Text="{loc:Loc Settings.ScheduleNote}" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <RadioButton x:Name="ScheduleOff" GroupName="Schedule" Content="{loc:Loc Settings.ScheduleOff}"
                                         Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource UiFont}"
                                         VerticalContentAlignment="Center" Margin="0,0,22,0" />
                            <RadioButton x:Name="ScheduleWeekly" GroupName="Schedule" Content="{loc:Loc Settings.ScheduleWeekly}"
                                         Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource UiFont}"
                                         VerticalContentAlignment="Center" Margin="0,0,22,0" />
                            <RadioButton x:Name="ScheduleMonthly" GroupName="Schedule" Content="{loc:Loc Settings.ScheduleMonthly}"
                                         Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource UiFont}"
                                         VerticalContentAlignment="Center" />
                        </StackPanel>

                        <CheckBox x:Name="ScheduleAtLogon" Content="{loc:Loc Settings.AtLogon}"
                                  Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource UiFont}"
                                  FontSize="13" Margin="0,0,0,14" />

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ApplyScheduleButton" Style="{StaticResource PrimaryButton}"
                                    Content="{loc:Loc Settings.Apply}" Click="OnApplySchedule" />
                            <TextBlock x:Name="ScheduleStatus" Style="{StaticResource SecondaryText}"
                                       VerticalAlignment="Center" Margin="16,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Область уведомлений -->
                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Margin="0,0,0,4" Text="{loc:Loc Settings.Tray}" />
                        <TextBlock Style="{StaticResource SecondaryText}" Margin="0,0,0,14"
                                   Text="{loc:Loc Settings.TrayNote}" />

                        <CheckBox x:Name="TrayEnabled" Content="{loc:Loc Settings.ShowTray}"
                                  Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource UiFont}"
                                  FontSize="13" Margin="0,0,0,10" Click="OnTraySettingChanged" />

                        <CheckBox x:Name="MinimizeToTray" Content="{loc:Loc Settings.MinimizeToTray}"
                                  Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource UiFont}"
                                  FontSize="13" Click="OnTraySettingChanged" />
                    </StackPanel>
                </Border>

                <!-- Язык -->
                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Margin="0,0,0,4" Text="{loc:Loc Settings.Language}" />
                        <TextBlock Style="{StaticResource SecondaryText}" Margin="0,0,0,14"
                                   Text="{loc:Loc Settings.LanguageNote}" />

                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="LanguageRussian" GroupName="Language" Content="{loc:Loc Settings.LanguageRussian}"
                                         Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource UiFont}"
                                         VerticalContentAlignment="Center" Margin="0,0,22,0" Click="OnLanguageChanged" />
                            <RadioButton x:Name="LanguageEnglish" GroupName="Language" Content="{loc:Loc Settings.LanguageEnglish}"
                                         Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource UiFont}"
                                         VerticalContentAlignment="Center" Click="OnLanguageChanged" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Обновления -->
                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Margin="0,0,0,4" Text="{loc:Loc Settings.Updates}" />
                        <TextBlock Style="{StaticResource SecondaryText}" Margin="0,0,0,14"
                                   Text="{loc:Loc Settings.UpdatesNote}" />

                        <CheckBox x:Name="UpdatesEnabled" Content="{loc:Loc Settings.CheckUpdates}"
                                  Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource UiFont}"
                                  FontSize="13" Click="OnUpdateSettingChanged" />
                    </StackPanel>
                </Border>

                <!-- Где лежит сохранённое -->
                <Border Style="{StaticResource Card}" Margin="0,14,0,24">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Margin="0,0,0,4" Text="{loc:Loc Settings.Rollback}" />
                        <TextBlock Style="{StaticResource SecondaryText}" Margin="0,0,0,14"
                                   Text="{loc:Loc Settings.RollbackNote}" />

                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource SecondaryButton}" Content="{loc:Loc Settings.OpenQuarantine}"
                                    Click="OnOpenQuarantine" Margin="0,0,10,0" />
                            <Button Style="{StaticResource SecondaryButton}" Content="{loc:Loc Settings.OpenBackups}"
                                    Click="OnOpenBackups" Margin="0,0,10,0" />
                            <Button Style="{StaticResource SecondaryButton}" Content="{loc:Loc Settings.CreateRestorePoint}"
                                    Click="OnCreateRestorePoint" Margin="0,0,10,0" />
                            <Button Style="{StaticResource SecondaryButton}" Content="{loc:Loc Settings.ShowTour}"
                                    Click="OnShowTour" />
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
