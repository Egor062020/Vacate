<UserControl x:Class="Vacate.App.Views.ListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Общая разметка для разделов, которые показывают список: программы, автозагрузка,
        расширения, диск, состояние дисков. Отдельная страница на каждый отличалась бы
        только заголовком и данными, а поддерживать пришлось бы пять почти одинаковых
        файлов разметки.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="TitleText" Style="{StaticResource PageTitle}" />
            <TextBlock x:Name="SubtitleText" Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <Button x:Name="RefreshButton" Style="{StaticResource PrimaryButton}" Content="Обновить" Click="OnRefresh" />
            <Button x:Name="ExtraButton" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                    Visibility="Collapsed" Click="OnExtra" />
            <TextBlock x:Name="StatusText" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="16,0,0,0" />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18">
                <ItemsControl x:Name="Items">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource BodyText}" Text="{Binding Title}" />
                                        <Border Background="{StaticResource AccentDimBrush}" CornerRadius="4"
                                                Padding="7,2" Margin="10,0,0,0"
                                                Visibility="{Binding BadgeVisibility}">
                                            <TextBlock Text="{Binding Badge}" FontSize="10"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource MonoText}" Text="{Binding Subtitle}" Margin="0,3,0,0" />
                                    <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding Note}" Margin="0,3,0,0"
                                               Visibility="{Binding NoteVisibility}" />
                                </StackPanel>

                                <TextBlock Grid.Column="1" Style="{StaticResource BodyText}" Text="{Binding Value}"
                                           FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
