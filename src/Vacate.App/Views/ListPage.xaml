<UserControl x:Class="Vacate.App.Views.ListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Vacate.App.Localization">

    <!--
        Общая разметка для разделов, которые показывают список: программы, автозагрузка,
        расширения, диск, состояние дисков. Отдельная страница на каждый отличалась бы
        только заголовком и данными, а поддерживать пришлось бы пять почти одинаковых
        файлов разметки.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="TitleText" Style="{StaticResource PageTitle}" />
            <TextBlock x:Name="SubtitleText" Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <Button x:Name="RefreshButton" Style="{StaticResource PrimaryButton}" Content="{loc:Loc Common.Refresh}" Click="OnRefresh" />
            <Button x:Name="ExtraButton" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                    Visibility="Collapsed" Click="OnExtra" />
            <Button x:Name="SecondExtraButton" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                    Visibility="Collapsed" Click="OnSecondExtra" />
            <!-- Полоса хода работы: чтение списка программ или обход диска занимает
                 время, и неподвижный экран всё это время читается как «зависло». -->
            <Border x:Name="ScanIndicator" Width="120" Height="3" Margin="16,0,0,0"
                    VerticalAlignment="Center" CornerRadius="2" Visibility="Collapsed"
                    Background="{StaticResource BorderBrush}" ClipToBounds="True">
                <Border x:Name="ScanPulse" Width="40" HorizontalAlignment="Left" CornerRadius="2"
                        Background="{StaticResource AccentBrush}">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="ScanPulseShift" />
                    </Border.RenderTransform>
                </Border>
            </Border>

            <TextBlock x:Name="StatusText" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="16,0,0,0" />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <!--
                Список выбираемый: в разделе «Программы» по строке выполняется действие,
                и цель этого действия человек должен видеть выделенной, а не держать в уме.
            -->
            <ListBox x:Name="Items" Padding="12" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="8,4" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Root" Background="Transparent" CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="{StaticResource CardHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentDimBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource BodyText}" Text="{Binding Title}" />
                                        <Border Background="{StaticResource AccentDimBrush}" CornerRadius="4"
                                                Padding="7,2" Margin="10,0,0,0"
                                                Visibility="{Binding BadgeVisibility}">
                                            <TextBlock Text="{Binding Badge}" FontSize="10"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource MonoText}" Text="{Binding Subtitle}" Margin="0,3,0,0" />
                                    <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding Note}" Margin="0,3,0,0"
                                               Visibility="{Binding NoteVisibility}" />
                                </StackPanel>

                                <TextBlock Grid.Column="1" Style="{StaticResource BodyText}" Text="{Binding Value}"
                                           FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
