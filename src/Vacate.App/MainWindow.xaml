<Window x:Class="Vacate.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vacate"
        Height="760" Width="1180"
        MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize">

    <!--
        Окно без стандартной рамки: заголовок рисуется свой, как и задумано оформлением.
        Перетаскивание и системные кнопки обрабатываются в коде окна.
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Боковая панель -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Знак и название -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,22,0,26">
                    <Canvas Width="28" Height="28" VerticalAlignment="Center">
                        <Path Data="M 6 5 L 14 22" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="3.6" StrokeStartLineCap="Square" StrokeEndLineCap="Square" />
                        <Path Data="M 22 5 L 18.5 12" Stroke="{StaticResource AccentBrush}" StrokeThickness="3.6" StrokeStartLineCap="Square" StrokeEndLineCap="Square" />
                        <Rectangle Canvas.Left="15" Canvas.Top="14" Width="3.6" Height="3.6" Fill="{StaticResource AccentBrush}" />
                        <Rectangle Canvas.Left="14" Canvas.Top="19" Width="2.6" Height="2.6" Fill="{StaticResource AccentBrush}" Opacity="0.6" />
                    </Canvas>
                    <TextBlock Text="Vacate" FontFamily="{StaticResource UiFont}" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>

                <!-- Разделы -->
                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="NavDashboard" Style="{StaticResource NavButton}" Content="Обзор" IsChecked="True" Checked="OnNavigate" Tag="dashboard" />
                    <RadioButton x:Name="NavClean" Style="{StaticResource NavButton}" Content="Очистка мусора" Checked="OnNavigate" Tag="clean" />
                    <RadioButton x:Name="NavApps" Style="{StaticResource NavButton}" Content="Программы" Checked="OnNavigate" Tag="apps" />
                    <RadioButton x:Name="NavStartup" Style="{StaticResource NavButton}" Content="Автозагрузка" Checked="OnNavigate" Tag="startup" />
                    <RadioButton x:Name="NavExtensions" Style="{StaticResource NavButton}" Content="Расширения браузеров" Checked="OnNavigate" Tag="extensions" />
                    <RadioButton x:Name="NavDisk" Style="{StaticResource NavButton}" Content="Место на диске" Checked="OnNavigate" Tag="disk" />
                    <RadioButton x:Name="NavHealth" Style="{StaticResource NavButton}" Content="Состояние системы" Checked="OnNavigate" Tag="health" />
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" Content="Настройки" Checked="OnNavigate" Tag="settings" />
                </StackPanel>

                <TextBlock Grid.Row="2" x:Name="VersionLabel" Style="{StaticResource SecondaryText}"
                           Margin="22,0,0,16" FontSize="11" Foreground="{StaticResource TextDisabledBrush}" />
            </Grid>
        </Border>

        <!-- Рабочая область -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Заголовок окна: перетаскивание и системные кнопки -->
            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnTitleBarDrag">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimize" ToolTip="Свернуть" />
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="OnMaximize" ToolTip="Развернуть" />
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="OnClose" ToolTip="Закрыть" />
                </StackPanel>
            </Border>

            <!--
                Сообщение о новой версии. Полоса, а не всплывающее окно: программа
                открыта ради дела, и перекрывать его сообщением, которое подождёт,
                значит мешать. Полоса скрыта, пока обновления нет.
            -->
            <Border x:Name="UpdateBanner" Grid.Row="1" Visibility="Collapsed"
                    VerticalAlignment="Top" Margin="34,0,34,0" Padding="16,12"
                    Background="{StaticResource CardBrush}" CornerRadius="{StaticResource ButtonRadius}"
                    BorderBrush="{StaticResource AccentDimBrush}" BorderThickness="1" Panel.ZIndex="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" x:Name="UpdateText" Style="{StaticResource BodyText}"
                               VerticalAlignment="Center" Margin="0,0,16,0" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButton}" Content="Открыть страницу"
                                Padding="14,7" Click="OnOpenUpdatePage" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Не сейчас"
                                Padding="14,7" Margin="8,0,0,0" Click="OnDismissUpdate" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Не проверять больше"
                                Padding="14,7" Margin="8,0,0,0" Click="OnDisableUpdates" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Содержимое раздела. Смена сопровождается сдвигом и растворением. -->
            <ContentControl Grid.Row="1" x:Name="PageHost" Margin="34,6,34,28">
                <ContentControl.RenderTransform>
                    <TranslateTransform />
                </ContentControl.RenderTransform>
            </ContentControl>
        </Grid>
    </Grid>
</Window>
