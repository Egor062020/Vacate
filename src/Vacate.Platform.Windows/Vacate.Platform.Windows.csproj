<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Платформенный слой: единственное место, где продукт обращается к файловой системе,
    реестру и системным вызовам Windows. Всё остальное работает через контракты.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Vacate.Platform.Windows</RootNamespace>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vacate.Abstractions\Vacate.Abstractions.csproj" />
    <ProjectReference Include="..\Vacate.Core\Vacate.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Состояние дисков Windows отдаёт через подсистему управления, без неё не обойтись. -->
    <PackageReference Include="System.Management" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Разбор команд удаления и построение слов для поиска остатков — внутренние детали,
      но именно они ломаются на реальных данных чаще всего, поэтому покрыты тестами напрямую.
    -->
    <InternalsVisibleTo Include="Vacate.Tests" />
  </ItemGroup>

</Project>
