<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Слой контрактов. Здесь живут модель данных и интерфейсы, через которые
    прикладной код общается с ядром.

    Целевая платформа объявлена честно как windows-only: продукт всё равно
    работает только под Windows, а попытка сделать вид, что этот слой
    кроссплатформенный, приводит к тому, что в него всё равно протекают
    системные типы — на это указал разбор версии 1.0 описания проекта.

    Чего здесь НЕТ и быть не должно:
      - никаких обращений к файловой системе и реестру (только описание намерений);
      - никаких типов WPF: этот слой не знает, что у продукта есть интерфейс.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Vacate.Abstractions</RootNamespace>
  </PropertyGroup>

</Project>
